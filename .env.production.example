# EPFD production environment. Copy into your host's secret/env manager (never commit real values).
# Values marked REQUIRED must be set; the app refuses to take payments with a misconfigured gateway.

APP_NAME="EPFD"
APP_ENV=production
# REQUIRED: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# REQUIRED
APP_URL=https://app.epfd.com.au
APP_TIMEZONE=UTC
# REQUIRED: printed on tax invoices
EPFD_ABN=

# Behind a load balancer / CDN: its addresses (comma-separated, CIDR ok), or * when only it can reach the app.
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Error tracking (https://sentry.io). Server: SENTRY_LARAVEL_DSN. Browser: VITE_SENTRY_DSN, passed as a Docker build arg.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=

# PostgreSQL 16+ with PostGIS
DB_CONNECTION=pgsql
# REQUIRED
DB_HOST=
DB_PORT=5432
DB_DATABASE=epfd
# REQUIRED
DB_USERNAME=
# REQUIRED
DB_PASSWORD=
DB_SSLMODE=require

# Redis for cache, sessions and queues (recommended). Without Redis use "database" for all three.
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Uploads (artwork, proofs, product images) live on the "local" disk: mount storage/app on a persistent volume
# shared by every web and worker container.
FILESYSTEM_DISK=local

# Transactional email (SES, Postmark or SMTP)
# REQUIRED: smtp | ses | postmark
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="Operations@epfd.com.au"
MAIL_FROM_NAME="EPFD"

# Payments. Keys can also be entered (encrypted) under Admin → Payment gateways, which overrides these.
# The active gateway is chosen under Admin → Settings; "mock" is refused in production.
PAYMENT_GATEWAY=stripe
# pk_live_…
STRIPE_KEY=
# sk_live_…
STRIPE_SECRET=
# whsec_… for https://<APP_URL>/api/v1/webhooks/stripe
# Stripe API version every request is pinned to (default is the latest; upgrade deliberately).
STRIPE_API_VERSION=2026-09-30.endive
STRIPE_WEBHOOK_SECRET=

# Australian Business Register lookup (free GUID: https://abr.business.gov.au/Tools/WebServices)
ABR_GUID=

# Maps
MAP_STACK=terra-google
# restrict to APP_URL's domain in Google Cloud
GOOGLE_MAPS_KEY=

# Backups (daily, Sydney night): database without G-NAF rows + uploaded files.
# BACKUP_DISKS is a comma-separated list of filesystem disks; use off-site storage in production.
BACKUP_NAME=epfd-backups
BACKUP_DISKS=local
BACKUP_NOTIFY_EMAIL=
# encrypts the backup zip
BACKUP_ARCHIVE_PASSWORD=

# G-NAF (quarterly address data): path inside the container to the unzipped release, for `php artisan gnaf:import`.
GNAF_PATH=/gnaf
GNAF_RELEASE_LABEL=

# Only one service should migrate on deploy (see docker-compose.production.yml).
RUN_MIGRATIONS=false
